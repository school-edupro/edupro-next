{
  "name": "edupro-next",
  "private": true,
  "version": "0.1.0",
  "description": "EduPro Next: multi-school, multi-year School ERP (Next.js, NestJS, PostgreSQL)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @edupro/db migrate",
    "db:test": "pnpm --filter @edupro/db test",
    "api:openapi": "pnpm --filter @edupro/api openapi:export",
    "client:generate": "pnpm --filter @edupro/api-client generate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "test:scripts": "node --test scripts/schema-diff.test.mjs && node packages/config/scripts/check-sql-rule.mjs",
    "schema-diff": "scripts/schema-diff.sh",
    "perf:local": "node perf/local.mjs"
  },
  "devDependencies": {
    "@edupro/config": "workspace:*",
    "autocannon": "^8.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.5",
      "postcss": "8.5.28",
      "@grpc/grpc-js": "^1.14.7",
      "follow-redirects": "^1.16.2",
      "handlebars": "^4.7.10",
      "joi@^17": "^17.13.9",
      "joi@^18": "^18.3.1",
      "re2js": "^2.9.1",
      "shell-quote": "^1.12.0",
      "systeminformation": "^5.33.19"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2023-54404"
      ]
    }
  }
}
