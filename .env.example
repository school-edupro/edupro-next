# Copy to .env for local development. Never commit .env. Production values come from Azure Key Vault.
# Do not set NODE_ENV here: Next.js manages it per command, and setting it to "development" breaks `next build`.

# PostgreSQL (docker compose). The API connects as the non-owner role edupro_app so RLS applies.
DATABASE_URL=postgresql://edupro_app:edupro_app_dev@localhost:5432/edupro
DATABASE_MIGRATOR_URL=postgresql://edupro_migrator:edupro_migrator_dev@localhost:5432/edupro

# Redis (docker compose)
REDIS_URL=redis://localhost:6379

# One Auth (OIDC). Local development can use the dev bypass below instead.
ONEAUTH_ISSUER=https://oneauth.mobilisepro.com
ONEAUTH_AUDIENCE=edupro-next
ONEAUTH_JWKS_URL=https://oneauth.mobilisepro.com/.well-known/jwks.json
ONEAUTH_CLIENT_ID=edupro-next-admin
ONEAUTH_CLIENT_SECRET=change-me-in-key-vault
ONEAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Development-only: when set, the API accepts an unsigned dev token "dev:<oneauth_sub>" in the Authorization header.
# Must be empty in every non-local environment. The API refuses to start with this set when NODE_ENV=production.
AUTH_DEV_BYPASS=1

# Admin app session cookie encryption key (32+ random bytes, base64). Generate: openssl rand -base64 32
SESSION_SECRET=change-me-32-bytes-minimum-base64
# Field-level encryption for Aadhaar, PAN and bank account numbers (32 bytes, base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; development derives a key from SESSION_SECRET when unset.
# Never change it once data is stored: existing values would no longer decrypt.
FIELD_ENCRYPTION_KEY=

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Admin app
NEXT_PUBLIC_APP_NAME="EduPro Next"
INTERNAL_API_BASE_URL=http://localhost:4000

# Mail (Mailpit in docker compose)
SMTP_URL=smtp://localhost:1025

# Files (Sprint 2). local = disk under apps/api/.data/uploads with HMAC-signed URLs served by the API;
# s3 = presigned URLs on S3-compatible storage (set S3_BUCKET, S3_REGION and optionally S3_ENDPOINT for MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
FILES_SIGNING_SECRET=dev-files-signing-secret-change-me
FILES_URL_TTL_SECONDS=900
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# ---- workers (Sprint 3) -------------------------------------------------------------------------
# Outbox publisher cadence and notification adapters. "console" adapters log ids only and are refused
# in production; configure the provider gateway per channel.
OUTBOX_POLL_MS=1000
NOTIFY_SMS_ADAPTER=console        # console | http
NOTIFY_WHATSAPP_ADAPTER=console   # console | http
NOTIFY_EMAIL_ADAPTER=console      # console | smtp
NOTIFY_PUSH_ADAPTER=console       # console | http
# SMTP_URL=smtp://localhost:1025
# SMTP_FROM=no-reply@school.example
# SMS_HTTP_URL=https://sms-gateway.example/send
# SMS_HTTP_TOKEN=
# WHATSAPP_HTTP_URL=
# WHATSAPP_HTTP_TOKEN=
EXPORT_PDF_ENGINE=playwright      # playwright | none (run `pnpm --filter @edupro/workers exec playwright install chromium` once)
EXPORTS_TTL_DAYS=7

# ---- compatibility API for the current mobile apps (Sprint 4) ------------------------------------
# COMPAT_HANDSHAKE_SECRET verifies the token the central auth server signs today; COMPAT_JWT_SECRET
# signs the app session the handshake returns. Both are required in production.
# COMPAT_HANDSHAKE_SECRET=
# COMPAT_JWT_SECRET=
COMPAT_TOKEN_HOURS=12

# ---- Sprint 5: security, observability, deployment -------------------------------------------------
# IMPERSONATION_JWT_SECRET=            # required in production (32+ characters)
IMPERSONATION_MAX_MINUTES=60
SECURITY_ALERT_THRESHOLD=10          # denials per minute per school that raise an alert
# SECURITY_ALERT_WEBHOOK=https://hooks.example/edupro-security
# METRICS_TOKEN=                       # bearer for /api/v1/metrics; required in production
# SCHEMA_CHECK=strict                  # strict | warn | off (strict in production by default)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# KEY_VAULT_URL=https://edupro-staging-kv.vault.azure.net/
# KEY_VAULT_SECRETS=DATABASE_URL=database-url,SESSION_SECRET=session-secret
# ONEAUTH_MFA_ACR=mfa                  # acr_values requested by the step-up flow
# Admin portal sends parents and students here
PARENT_APP_URL=http://localhost:3001
