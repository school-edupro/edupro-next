{
  "name": "@edupro/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Mobilise Design System tokens and React components for EduPro Next",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/index.css",
    "./app.css": "./src/app.css"
  },
  "files": ["dist", "src/tokens", "src/app.css", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json src && eslint src",
    "test": "echo \"visual tests run in Storybook (Sprint 3)\""
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@edupro/config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.12.0",
    "oxlint": "^0.9.10",
    "typescript": "^5.6.2"
  }
}
