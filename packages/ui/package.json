{
  "name": "@edupro/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Mobilise Design System tokens and React components for EduPro Next",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/index.css",
    "./app.css": "./src/app.css"
  },
  "files": [
    "dist",
    "src/tokens",
    "src/app.css",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json src && eslint src",
    "test": "echo \"component tests: pnpm --filter @edupro/ui test:storybook (interaction tests through the Storybook test runner)\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:storybook": "concurrently -k -s first -n SB,TEST \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --maxWorkers 2\""
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@edupro/config": "workspace:*",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.24.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.12.0",
    "http-server": "^14.1.1",
    "oxlint": "^0.9.10",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  }
}
