{
  "name": "@edupro/etl",
  "version": "0.1.0",
  "private": true,
  "description": "Legacy MySQL to PostgreSQL migration: transforms, identity map, pipeline runner, reconciliation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
