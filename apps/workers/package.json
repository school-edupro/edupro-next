{
  "name": "@edupro/workers",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ processors: notifications, exports, RFID events, reconciliation, maintenance",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@edupro/db": "workspace:*",
    "@edupro/storage": "workspace:*",
    "bullmq": "^5.15.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "playwright": "^1.63.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@edupro/config": "workspace:*",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.12.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
