{
  "name": "@edupro/admin",
  "version": "0.1.0",
  "private": true,
  "description": "EduPro Next admin application (Next.js, thin BFF)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint app components lib middleware.ts && oxlint -c ../../packages/ui/.oxlintrc.json app components lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"admin e2e: pnpm --filter @edupro/admin e2e (Playwright smoke against a running stack)\"",
    "e2e": "playwright test --project smoke",
    "e2e:visual": "playwright test --project visual",
    "e2e:a11y": "playwright test --project a11y"
  },
  "dependencies": {
    "@edupro/ui": "workspace:*",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "jose": "^5.9.3",
    "leaflet": "1.9.4",
    "next": "^15.0.0",
    "next-intl": "^4.14.7",
    "openid-client": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@edupro/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.12.0",
    "eslint-config-next": "^15.0.0",
    "oxlint": "^0.9.10",
    "typescript": "^5.6.2"
  }
}
